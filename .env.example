# Fish Audio API Configuration
# Get your API key from https://fish.audio/
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Voice Model / Reference ID (Optional)
# Leave empty to use Fish Audio's default voice, or paste a model ID from the Fish Audio library.
# Example: FISH_AUDIO_REFERENCE_ID=fbe02f8306fc4d3d915e9871722a39d5
FISH_AUDIO_REFERENCE_ID=

# Model Name (Optional, defaults to s2.1-pro-free for the free developer tier)
# Options: s2.1-pro-free, s2.1-pro, s2-pro, drama-3-preview
FISH_AUDIO_MODEL=s2.1-pro-free

# Output Format (Optional, defaults to mp3; wav and opus also supported)
FISH_AUDIO_FORMAT=mp3

# Latency tradeoff (Optional, normal | balanced | low; defaults to balanced)
FISH_AUDIO_LATENCY=balanced
